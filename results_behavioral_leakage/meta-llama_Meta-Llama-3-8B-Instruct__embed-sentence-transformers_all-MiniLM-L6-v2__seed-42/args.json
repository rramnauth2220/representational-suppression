{
  "model": "meta-llama/Meta-Llama-3-8B-Instruct",
  "concepts_path": "concepts.json",
  "outdir": "results_behavioral_leakage",
  "device": "cuda",
  "fp16": false,
  "bf16": true,
  "load_4bit": false,
  "device_map_auto": true,
  "trust_remote_code": false,
  "use_chat_template": true,
  "system_prompt": null,
  "include_indirect": true,
  "indirect_mode": "first",
  "max_indirect_per_concept": 2,
  "include_unrelated_control": true,
  "default_unrelated_control": "flowers",
  "n_samples": 3,
  "max_prompt_length": 512,
  "max_new_tokens": 80,
  "temperature": 0.7,
  "top_p": 0.95,
  "embedding_model": "sentence-transformers/all-MiniLM-L6-v2",
  "embedding_device": "cuda",
  "embedding_batch_size": 32,
  "embedding_max_length": 256,
  "embedding_trust_remote_code": false,
  "concept_embedding_source": "all",
  "successful_suppression_only": true,
  "save_prompts": false,
  "seed": 42
}