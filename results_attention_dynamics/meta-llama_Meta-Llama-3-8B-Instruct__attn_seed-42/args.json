{
  "model": "meta-llama/Meta-Llama-3-8B-Instruct",
  "concepts_path": "concepts.json",
  "outdir": "results_attention_dynamics",
  "device": "cuda",
  "layers": "all",
  "max_length": 256,
  "fp16": false,
  "bf16": true,
  "load_4bit": false,
  "device_map_auto": true,
  "trust_remote_code": false,
  "attn_implementation": "eager",
  "use_chat_template": true,
  "system_prompt": null,
  "include_indirect": true,
  "indirect_mode": "first",
  "max_indirect_per_concept": 2,
  "include_unrelated_control": true,
  "default_unrelated_control": "flowers",
  "unrelated_control_region": "target_alias",
  "include_context_region": false,
  "keep_missing_regions": false,
  "save_token_region_debug": false,
  "top_k_heads": 30,
  "seed": 42
}